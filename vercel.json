{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/:path*.html", "destination": "/frontend/:path*.html" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/:path*.js", "destination": "/frontend/:path*.js" },
    { "source": "/:path*.css", "destination": "/frontend/:path*.css" }
  ]
}
